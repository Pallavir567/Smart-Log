# Smart-Log Environment Variables
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartlog-dev-secret-key-change-in-production
DATABASE_PATH=backend/database/smartlog.db
UPLOAD_FOLDER=backend/uploads
ARTIFACT_FOLDER=backend/artifacts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes
